# ── LLM provider (pick one) ──────────────────────────────────────────────────
# Groq — free, fastest streaming
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Google Gemini — free tier, generous limits
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=

# OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./app/data/grillme.db

# ── Avatar (optional — requires Docker avatar-service + wav2lip model) ────────
AVATAR_PROVIDER=local          # change to wav2lip after Docker setup
AVATAR_SERVICE_URL=http://localhost:8080
VIDEOS_DIR=/tmp/grillme_videos
